# ============================================================
# SecurePay Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your local values.
# NEVER commit the real .env file or real secrets to Git.
# ============================================================

# ------------------------------------------------------------
# 1. CURRENTLY REQUIRED (Used by backend/frontend today)
# ------------------------------------------------------------

# PostgreSQL Database Password (user: postgres, database: securepay)
DB_PASSWORD=your_local_postgres_password

# Keycloak Backend Client Secret (from Keycloak Admin Console > securepay realm > Clients > securepay-backend > Credentials)
KEYCLOAK_CLIENT_SECRET=your_keycloak_backend_client_secret

# ------------------------------------------------------------
# 2. REQUIRED LATER (For Docker Compose, Config Parameterization & Gateway)
# ------------------------------------------------------------

# Database Connection (parameterized in future milestones)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=securepay
# DB_USERNAME=postgres

# Keycloak Endpoints
# KEYCLOAK_SERVER_URL=http://localhost:8082
# KEYCLOAK_REALM=securepay
# KEYCLOAK_CLIENT_ID=securepay-backend

# Frontend API Base URL
# VITE_API_BASE_URL=http://localhost:8080

# Razorpay Sandbox (Milestone 17+)
# RAZORPAY_KEY_ID=your_razorpay_test_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Kafka Broker (Milestone 20+)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------
# 3. OPTIONAL (Local development overrides / Mailpit)
# ------------------------------------------------------------
# SMTP_HOST=localhost
# SMTP_PORT=1025
