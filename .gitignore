# ============================================================
# SecurePay Root Git Ignore
# ============================================================

# Operating System & Local Metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Environment & Secrets (MANDATORY - NEVER COMMIT)
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.jks

# IntelliJ IDEA (Local & User-Specific Only)
.idea/dataSources.xml
.idea/dataSources.local.xml
.idea/dataSources/
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
*.iws
*.ipr

# Eclipse / VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.settings/

# Maven & Java Build Outputs
**/target/
**/.mvn/wrapper/maven-wrapper.jar

# Frontend & Node Build Outputs
**/node_modules/
**/dist/
**/dist-ssr/
.npm
.eslintcache

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test Reports & Temporary Directories
**/surefire-reports/
tmp/
temp/
